PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://localhost:27017/eps_portal for local dev)
MONGODB_URI=mongodb://localhost:27017/eps_portal

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the React app is served from. Comma-separate for several origins. Leave empty if Express serves the built frontend itself.
CORS_ORIGIN=http://localhost:5173

# Set to "none" only when frontend and API are on different domains (requires HTTPS). Otherwise "lax".
COOKIE_SAMESITE=lax

# Only for `npm run migrate` (your current Neon connection string)
DATABASE_URL=
# Optional: path to the React build to serve from this server (e.g. ../eps-portal-frontend/dist)
FRONTEND_DIST=
